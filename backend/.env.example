# ─── Application ───
APP_NAME=Enterprise Architecture
APP_VERSION=1.0.0
DEBUG=false

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/base-app-setup
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── JWT Authentication ───
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── File storage ───
# Base directory for everything the app writes to disk (log files today). Point
# this at the mounted storage volume in a deployment; use a per-app subdir if the
# mount is shared with other services. Must be writable by the application user.
UPLOAD_DIR=storage

# ─── Logging ───
# LOG_FILE_PATH is relative, so it resolves beneath UPLOAD_DIR (see above).
# Set an absolute path here to write logs outside the storage root instead.
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/application.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ─── Object storage ───
# local (default): files are written under UPLOAD_DIR/files.
# s3:              files are stored in the bucket below.
STORAGE_BACKEND=local

# Read only when STORAGE_BACKEND=s3. Bucket name only, not an ARN or URL.
S3_BUCKET=
S3_REGION=ap-south-1
# Prepended to every key so apps/environments can share one bucket. e.g. architecture/prod
S3_KEY_PREFIX=
# Leave blank to use an instance/task role or OIDC (preferred). Static keys need rotation.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for MinIO/Wasabi/R2/Ceph. Empty means real AWS.
S3_ENDPOINT_URL=
# Empty auto-selects virtual for AWS, path for a custom endpoint. Never 'auto' on AWS.
S3_ADDRESSING_STYLE=
# when_required avoids the aws-chunked upload encoding some proxies drop.
S3_CHECKSUM_MODE=when_required
# PEM bundle incl. internal root CA for TLS-inspecting networks. Empty uses botocore's roots.
S3_CA_BUNDLE=
# Lifetime of presigned download URLs, in seconds.
S3_PRESIGN_EXPIRY_SECONDS=900
# Largest accepted upload, enforced while streaming.
STORAGE_MAX_UPLOAD_BYTES=26214400

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── Login throttling (brute-force / credential-stuffing protection) ───
# Applies to POST /api/v1/auth/login. Defaults shown; see ARCHITECTURE.md "Login throttling".
# The counters live in Redis (REDIS_URL above) so every API replica shares them. If Redis is
# unreachable, or REDIS_URL is empty, they fall back to per-process counters, which multiply
# across replicas: run Redis wherever there is more than one API process.
# Master switch. Leave on; it exists so a bad limit can be turned off without a deploy.
LOGIN_THROTTLE_ENABLED=true
# How long attempts are remembered (fixed from the first attempt).
LOGIN_ATTEMPT_WINDOW_SECONDS=300
# Attempts at one account from one IP per window before it is locked for that IP.
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT_IP=5
# Attempts at one account, from all addresses it has no successful login from, together per
# window before it is locked for such addresses. Addresses it has logged in from are not
# counted or locked, so a spread-out attack cannot lock the real user out of their usual network.
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=20
# How long an address stays "familiar" to an account after a successful login from it (each
# login restarts the time). Default 30 days. 0 turns this off: every address is a stranger.
LOGIN_FAMILIAR_IP_TTL_SECONDS=2592000
# Failed logins from one IP per window, any username. Generous: offices share an address.
LOGIN_MAX_FAILURES_PER_IP=50
# How long a lockout lasts. Attempts made during it do not extend it.
LOGIN_LOCKOUT_SECONDS=900
# How many reverse proxies sit between the internet and this API. Used to find the real
# client address in X-Forwarded-For for the per-IP limits. 0 ignores the header: it cannot
# be forged, but behind a proxy every user then shares the proxy's address.
#   client -> api                        0
#   client -> nginx -> api               1
#   client -> load balancer -> nginx -> api   2   (verify against your deployment)
# Too high trusts entries the client wrote. Only sound if the API is reachable solely
# through that chain.
TRUSTED_PROXY_HOPS=0

# ─── Celery ───
CELERY_BROKER_URL=redis://localhost:6379/1

# ─── OpenTelemetry ───
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=compliance-api

# ─── Azure AD / Microsoft SSO ───
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:6769/oauth/v2/callback

# ─── CORS ───
CORS_ORIGINS=["http://localhost:6769"]

# ─── Auth Cookies (refresh token) ───
# COOKIE_SECURE must be true in production (HTTPS). Keep false for local http dev.
# For cross-site (API on a different domain than the SPA) use COOKIE_SAMESITE=none + COOKIE_SECURE=true.
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
